PORT=5007
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notification?schema=public

AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

NOTIFICATION_QUEUE_NAME=notification-service-queue

# See src/infrastructure/messaging/topic-arn.util.ts for the naming assumption these defaults encode.
TOPIC_ORDER_CONFIRMED=orders-contracts-v1-order-confirmed-v1
TOPIC_PAYMENT_SUCCEEDED=payments-contracts-v1-payment-succeeded-v1
TOPIC_PAYMENT_FAILED=payments-contracts-v1-payment-failed-v1
TOPIC_TICKET_CONFIRMED=ticketing-contracts-v1-ticket-confirmed-v1
TOPIC_NOTIFICATIONS_OUTBOUND=notifications-outbound

# true when infra (Terraform) already provisioned the queue/topics/subscriptions — this service will not call SNS/SQS to create anything.
SKIP_QUEUE_PROVISIONING=false

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
