# Auth Service — local environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL connection string for auth-db (see ARCHITECTURE.md §3, one DB per service).
DATABASE_URL="postgresql://auth_service:auth_service@localhost:5432/auth_db?schema=public"

# HS256 shared secret used to sign/verify access tokens.
# PoC simplification — RS256 with rotated keys is the production upgrade (see DECISIONS.md).
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Access token TTL. Accepts Xs / Xm / Xh / Xd shorthand (see docs/CONTRACTS.md §3).
JWT_ACCESS_TTL="15m"

# Refresh token TTL, in days.
JWT_REFRESH_TTL_DAYS=7

# HTTP port (5001 per docs/CONTRACTS.md §1).
PORT=5001

# OTLP HTTP endpoint traces are exported to. The Aspire dashboard plays this role locally.
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

NODE_ENV=development
